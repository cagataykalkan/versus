rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Username uniqueness lookup: anyone can check availability,
    // only an authenticated user can reserve one, and only the owner
    // of a reservation can release it (e.g. when changing usernames).
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // A user's own profile document.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
